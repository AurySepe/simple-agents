{
  "name": "formal-agent-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo formale fortemente tipizzato per agenti autonomi a 3 livelli",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "demo": "tsx examples/run-walkthrough-demo.ts",
    "export-json": "tsx examples/export-state-json.ts",
    "benchmark": "tsx examples/benchmark-models.ts",
    "career:batch": "npm --workspace=@formal-agent/example-career-agent run batch",
    "career:live": "npm --workspace=@formal-agent/example-career-agent run live"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
