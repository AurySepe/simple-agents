# ==============================================================================
# CONFIGURAZIONE LLAMA-SERVER (LLAMA.CPP) PER GPU CONSUMER 8GB
# ==============================================================================

# Percorso relativo o nome del file GGUF montato in ./models
MODEL_FILE=qwen3.5-9b.gguf

# Porta HTTP su cui esporre l'API compatibile OpenAI
PORT=30000

# Numero di layer da scaricare interamente sulla GPU (99 = tutti quelli disponibili)
N_GPU_LAYERS=99

# Dimensione della finestra di contesto (token)
CTX_SIZE=8192

# Flash Attention per ottimizzazione memoria e throughput ('on' / 'off')
FLASH_ATTENTION=on

# Attivazione template Jinja con supporto parsing tool calls
JINJA=true
