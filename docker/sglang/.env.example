# ==============================================================================
# CONFIGURAZIONE SGLANG PER GPU CONSUMER 8GB (es. RTX 5070 / 4060 / 4070)
# ==============================================================================

# Modello Hugging Face da eseguire:
MODEL_PATH=QuantTrio/Qwen3.5-9B-AWQ

# Porta HTTP su cui esporre l'API compatibile OpenAI
PORT=30000

# Percentuale massima di VRAM da riservare (0.90 = 90% per weights + KV cache)
MEM_FRACTION_STATIC=0.90

# Numero massimo di richieste contemporanee (1 = singolo agente sequenziale, minimizza la cache Mamba)
MAX_RUNNING_REQUESTS=1

# Finestra massima di contesto in token
CONTEXT_LENGTH=4096

# Parser per il tool calling di Qwen e motore di vincolo grammaticale
TOOL_CALL_PARSER=qwen
REASONING_PARSER=qwen3
GRAMMAR_BACKEND=xgrammar

# Ottimizzazioni per 8GB: limite esplicito mamba cache e disattivazione grafi prefill
EXTRA_ARGS=--max-mamba-cache-size 1 --cuda-graph-backend-prefill disabled

