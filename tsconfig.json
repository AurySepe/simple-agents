{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@simple-agents/core": ["./packages/core/src/index.ts"],
      "@simple-agents/core/*": ["./packages/core/src/*"],
      "@simple-agents/adapters": ["./packages/adapters/src/index.ts"],
      "@simple-agents/adapters/*": ["./packages/adapters/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/tests/**/*",
    "examples/**/*"
  ]
}
